{
  "name": "use-gidl",
  "version": "0.1.2",
  "description": "CLI for adding gidl's animated UI components to your project.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "use-gidl": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "homepage": "https://gidl.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/heysolomon/gidl",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/heysolomon/gidl/issues",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "nextjs",
    "react",
    "shadcn",
    "ui-components",
    "registry",
    "animation"
  ],
  "author": "Solomon Akuson",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^12.1.0",
    "fs-extra": "^11.4.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
