{
  "name": "gidl",
  "version": "0.1.0",
  "private": true,
  "description": "Animated UI components, rebuilt as a shadcn/ui registry",
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs",
    "dev": "turbo dev",
    "build": "pnpm registry:build && turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@turbo/gen": "^2.10.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.5",
      "esbuild": "^0.28.2",
      "fast-uri@<3.1.9": "^3.1.9",
      "ip-address@<10.7.4": "^10.7.4",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "source-map-js@<1.2.2": "^1.2.2",
      "proxy-addr@<2.0.8": "^2.0.8",
      "@modelcontextprotocol/sdk@<1.32.0": "^1.32.0",
      "zod@>=4.0.0 <4.6.6": "^4.6.6",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "systeminformation@<5.33.16": "^5.33.16",
      "@hono/node-server@<2.1.6": "^2.1.6",
      "qs@<6.16.1": "^6.16.1",
      "hono@<4.13.16": "^4.13.16"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
