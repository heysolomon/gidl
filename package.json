{
  "name": "gidl",
  "version": "0.1.0",
  "private": true,
  "description": "Animated UI components, rebuilt as a shadcn/ui registry",
  "scripts": {
    "registry:build": "node scripts/build-registry.mjs",
    "dev": "turbo dev",
    "build": "pnpm registry:build && turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@turbo/gen": "^2.10.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "sharp": "^0.35.4",
      "esbuild": "^0.28.2"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
